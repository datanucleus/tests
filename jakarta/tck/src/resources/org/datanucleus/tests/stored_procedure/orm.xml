<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm
    https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
    version="3.1">

    <named-stored-procedure-query name="name1" procedure-name="DummyStoredProcedure">
        <parameter mode="IN" class="java.lang.Integer"/>
        <parameter mode="OUT" class="java.lang.String"/>
    </named-stored-procedure-query>

    <sql-result-set-mapping name="name2">
       <constructor-result target-class="org.datanucleus.tests.jakarta.tck.storedprocedure.User">
           <column name="ID" class="java.lang.Long"/>
           <column name="LOGINNAME" class="java.lang.String"/>
       </constructor-result>
    </sql-result-set-mapping>
</entity-mappings>
